# Servicio de datos de Mi VistApp. Copiar a /etc/systemd/system/mivistapp.service (ver docs/raspberry.md).
[Unit]
Description=Mi VistApp (servicio de datos)
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
User=mivistapp
EnvironmentFile=/etc/mivistapp/vps.env
# La Raspberry Pi 3B+ tiene 1 GB: el servicio usa poco, pero se limita por si acaso.
ExecStart=/usr/bin/node --max-old-space-size=192 /opt/mivistapp/server.cjs
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
