# Copia este fichero como /etc/mivistapp/vps.env en el VPS y rellénalo. Nunca lo subas al repo.
# Todos los valores de aquí son de ejemplo.

# Clave compartida con la skill. Genérala con: openssl rand -hex 32
VISTAPP_API_KEY=pon-aqui-una-clave-de-64-caracteres-generada-con-openssl

# Dónde escucha el servicio (detrás de Caddy, que pone el HTTPS)
HOST=127.0.0.1
PORT=8787

VISTAPP_TIMEZONE=Europe/Madrid
VISTAPP_CITY_LABEL=Ciudad
VISTAPP_ROUTE_LABEL=Casa → Trabajo

# Coordenadas (en Google Maps: clic derecho sobre el sitio → copiar las coordenadas)
VISTAPP_HOME_LAT=40.000000
VISTAPP_HOME_LON=-3.000000
VISTAPP_WORK_LAT=40.100000
VISTAPP_WORK_LON=-3.100000
# Hora de entrada al trabajo, para "Sal a las hh:mm"
VISTAPP_WORK_START=09:00

# Aviso de salida (minutos)
VISTAPP_BUFFER_MINUTES=10
VISTAPP_ALERT_APPEAR_MINUTES=30
VISTAPP_ALERT_SOON_MINUTES=10

# Cada cuánto se vuelve a consultar cada fuente (minutos)
VISTAPP_REFRESH_WEATHER_MINUTES=15
VISTAPP_REFRESH_TRAFFIC_MINUTES=5
VISTAPP_REFRESH_CALENDAR_MINUTES=5

# TomTom (developer.tomtom.com → crea una clave con Routing y Search)
TOMTOM_API_KEY=

# iCloud: Apple ID y contraseña de app (appleid.apple.com → Inicio de sesión y seguridad → Contraseñas de app)
ICLOUD_USERNAME=
ICLOUD_APP_PASSWORD=
# Opcional: solo estos calendarios, separados por comas (vacío = todos)
ICLOUD_CALENDARS=
