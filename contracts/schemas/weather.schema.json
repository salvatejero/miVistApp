{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mivistapp.local/contracts/weather.schema.json",
  "title": "Pantalla Tiempo (datasource `weather`)",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/section"
    }
  ],
  "properties": {
    "status": true,
    "message": true,
    "city": {
      "type": "string"
    },
    "days": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": [
          "name",
          "dateLabel",
          "isToday",
          "icon",
          "maxTemp",
          "minTemp",
          "rainProbability"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "Hoy, Vie, Sáb…"
          },
          "dateLabel": {
            "type": "string"
          },
          "isToday": {
            "type": "boolean"
          },
          "icon": {
            "$ref": "common.schema.json#/$defs/weatherIcon"
          },
          "maxTemp": {
            "type": "number"
          },
          "minTemp": {
            "type": "number"
          },
          "rainProbability": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        }
      }
    },
    "hourlyRain": {
      "$ref": "common.schema.json#/$defs/rainForecast"
    }
  },
  "if": {
    "type": "object",
    "properties": {
      "status": {
        "const": "ok"
      }
    }
  },
  "then": {
    "required": [
      "city",
      "days",
      "hourlyRain"
    ]
  },
  "unevaluatedProperties": false
}
