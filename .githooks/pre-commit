#!/usr/bin/env bash
# Frena commits con ficheros sensibles. Activar una vez: git config core.hooksPath .githooks
bad=$(git diff --cached --name-only --diff-filter=ACM | grep -E '(^|/)(\.env(\..*)?|.*\.pem|.*\.key|id_rsa.*)$' | grep -v -E '\.env\.example$' || true)
if [ -n "$bad" ]; then
  echo "Commit bloqueado: ficheros sensibles en el commit:"
  echo "$bad"
  exit 1
fi
